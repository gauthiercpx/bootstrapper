# Copy to .env for local development. Never commit .env.
{{ env_prefix }}ENVIRONMENT=local
{{ env_prefix }}DEBUG=true
{{ env_prefix }}LOG_LEVEL=INFO
{{ env_prefix }}CORS_ORIGINS=["http://localhost:5173"]
{% if uses_database %}

{% if database == "postgres" %}
# Async driver is required (postgresql+asyncpg, not postgresql).
{{ env_prefix }}DATABASE_URL=postgresql+asyncpg://{{ package_name }}:{{ package_name }}@localhost:5432/{{ package_name }}
{% else %}
{{ env_prefix }}DATABASE_URL=sqlite+aiosqlite:///./{{ package_name }}.db
{% endif %}
{{ env_prefix }}DATABASE_ECHO=false
{% endif %}
