"""Request and response models for the example resource.

Kept separate from the SQLAlchemy models on purpose: the wire format and the
storage format drift apart the moment the project is real.
"""

from __future__ import annotations

from datetime import datetime

from pydantic import BaseModel, ConfigDict, Field


class ItemCreate(BaseModel):
    """Payload accepted by `POST /items`."""

    name: str = Field(min_length=1, max_length=200)
    description: str | None = Field(default=None, max_length=10_000)


class ItemUpdate(BaseModel):
    """Payload accepted by `PATCH /items/{id}` — every field optional."""

    name: str | None = Field(default=None, min_length=1, max_length=200)
    description: str | None = Field(default=None, max_length=10_000)


class ItemRead(BaseModel):
    """What the API returns."""

    model_config = ConfigDict(from_attributes=True)

    id: int
    name: str
    description: str | None
    created_at: datetime
    updated_at: datetime
