[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ slug }}"
version = "0.1.0"
description = "{{ description or name }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
{% if license != "proprietary" %}
license = { text = "{{ license }}" }
{% endif %}
{% if author %}
authors = [{ name = "{{ author }}"{% if author_email %}, email = "{{ author_email }}"{% endif %} }]
{% endif %}
dependencies = [
  "fastapi>=0.115",
  "uvicorn[standard]>=0.30",
  "pydantic>=2.7",
  "pydantic-settings>=2.3",
{% if uses_database %}
  "sqlalchemy[asyncio]>=2.0.30",
  "alembic>=1.13",
{% if database == "postgres" %}
  "asyncpg>=0.29",
{% else %}
  "aiosqlite>=0.20",
{% endif %}
{% endif %}
]

[project.optional-dependencies]
dev = [
  "pytest>=8.0",
  "pytest-asyncio>=0.23",
  "httpx>=0.27",
  "ruff>=0.5",
  "mypy>=1.10",
{% if uses_database and database == "postgres" %}
  "aiosqlite>=0.20",
{% endif %}
]

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q"
asyncio_mode = "auto"

[tool.ruff]
line-length = 100
target-version = "py{{ python_version | replace(".", "") }}"

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM"]
{% if uses_database %}

[tool.ruff.lint.per-file-ignores]
# Alembic writes these files; its line lengths and import order are its own.
# Real problems (undefined names, unused imports) are still reported.
"migrations/versions/*" = ["E501", "I001"]

[tool.ruff.format]
exclude = ["migrations/versions/*"]
{% endif %}

[tool.mypy]
python_version = "{{ python_version }}"
strict = true
plugins = ["pydantic.mypy"]
