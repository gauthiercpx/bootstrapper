name: CI

on:
  push:
    branches: [{{ default_branch }}]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  # A new push to a branch cancels the run still in flight for it.
  group: ci-{{ gh('github.ref') }}
  cancel-in-progress: true

jobs:
  quality:
    name: Lint, typecheck and test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "{{ python_version }}"
          cache: pip
          cache-dependency-path: pyproject.toml

      - name: Install
        run: |
          python -m pip install --upgrade pip
          pip install -e ".[dev]"

      - name: Lint
        run: |
          ruff check --output-format=github .
          ruff format --check .

      - name: Typecheck
        run: mypy src

      - name: Test
        run: pytest
{% if uses_database %}

  migrations:
    name: Migrations apply cleanly
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "{{ python_version }}"
          cache: pip
          cache-dependency-path: pyproject.toml

      - name: Install
        run: |
          python -m pip install --upgrade pip
          pip install -e ".[dev]"

      - name: Upgrade to head
        # Runs against a throwaway SQLite file: this checks that every revision
        # applies in order, without needing a database service.
        env:
          {{ env_prefix }}DATABASE_URL: sqlite+aiosqlite:///./ci.db
        run: alembic upgrade head
{% endif %}
{% if has_addon('docker') %}

  image:
    name: Image builds
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: docker/setup-buildx-action@v3

      - name: Build (no push)
        uses: docker/build-push-action@v6
        with:
          context: .
          push: false
          tags: {{ slug }}:ci-{{ gh('github.sha') }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
{% endif %}
