# Run `fly launch --no-deploy` once to create the app, then `fly deploy`.
app = "{{ slug }}"
primary_region = "cdg"

[build]

[env]
  {{ env_prefix }}ENVIRONMENT = "production"
  {{ env_prefix }}LOG_LEVEL = "INFO"

[http_service]
  internal_port = 8000
  force_https = true
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 0

  [[http_service.checks]]
    grace_period = "10s"
    interval = "30s"
    method = "GET"
    path = "/health/ready"
    timeout = "5s"

[[vm]]
  size = "shared-cpu-1x"
  memory = "512mb"
{% if uses_database %}

# Secrets are not stored here. Set the database URL once with:
#   fly secrets set {{ env_prefix }}DATABASE_URL='postgresql+asyncpg://...'
{% endif %}
