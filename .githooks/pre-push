#!/bin/sh
# The same checks CI runs, before the push leaves this machine.
# Enable once per clone with `make hooks`.
set -e

echo "pre-push: make check"
make check

if command -v sonar-scanner >/dev/null 2>&1; then
    if [ -z "$SONAR_TOKEN" ]; then
        echo "pre-push: sonar-scanner is installed but SONAR_TOKEN is not set -- skipping the scan" >&2
    else
        echo "pre-push: sonar-scanner"
        sonar-scanner
    fi
else
    echo "pre-push: sonar-scanner not found on PATH -- skipping the scan (CI still runs it)" >&2
fi
